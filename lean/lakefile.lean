-- The trust audit's import list. `Checks/Axioms.lean` imports this module
-- rather than a hand-maintained umbrella, so a module added anywhere under
-- the ordinary library's glob is walked by `run_cmd auditEnvironment` on the
-- next `lake build`, with no shared import list to forget. Only the glob's
-- own modules are listed: the generated image roots are reached through the
-- proofs that import them, and `tools/check_lean_policy.py` fails on any
-- module, generated or not, the built walk did not cover.
@[default_target]
lean_lib ChecksAll where
  srcDir := ".lake/generated"
  roots := #[`LinuxProcessSemantics.LinuxProcessSem.Checks.All]

-- The syscall registry's import list, the same way.  `Sys/SyscallTable.lean`
-- is generated by `tools/gen_lean_registry.py` from one registry module per
-- twin under `Sys/Registry/`, and imports this module to reach them all; the
-- module is written here from the library's glob so that a port adds its
-- registry file and edits no import list.  It is a build product, like
-- `Checks/All`, and is declared after `LinuxProcessSemantics` for the same
-- reason.
--
-- It is `Sys.Registry.All`, a SIBLING of the registry files and not their
-- prefix, because Lake counts every submodule of a root as the root's
-- library when a glob matches the root (`LeanLibConfig.isBuildableModule`,
-- Lake v4.34.0) and `findModule?` takes the last library claiming a name:
-- an umbrella named `Sys.Registry` claimed every `Sys.Registry.*` source
-- file for this generated library, so a full build passed (the ordinary
-- library had already built them under the same names) while
-- `lake build <module>` by name -- what tools/lean_mutate.py's scratch runs
-- -- looked for them under `.lake/generated` and failed (2026-09-16).
@[default_target]
lean_lib SysRegistry where
  srcDir := ".lake/generated"
  roots := #[`LinuxProcessSemantics.LinuxProcessSem.Sys.Registry.All]

-- The syscall table and its lookup pins, rendered from the same registry
-- files by `tools/gen_lean_registry.py` (its docstring is the shape and the
-- refusals).  T22 gave every arm its own registry file and left these two
-- committed, which moved the conflict one level down rather than away: 20
-- commits of two days touched each of them -- the same 20 `lean: port` PRs --
-- while the busiest single registry file took 2.  They are build products
-- here for that reason, and the port PRs' diffs no longer contain them.
--
-- Unlike the two import lists above, this one is not written in Lean: the
-- render is 500 lines of Rocq-derived text with six validation rules behind
-- it, and the tool that renders it is also what `generated-docs` runs
-- without a toolchain.  So the facet shells out to it with an explicit
-- dependency array, as the rwx images do, and the array is what the TEXT is
-- a function of: the generator with the tool modules it imports, the Rocq
-- table it mirrors, and the registry files.
--
-- What is deliberately NOT in it, although the generator opens all of it:
-- the Lean twins under `Sys/`, and `theories/LinuxProcessSem` beyond the
-- table itself -- `defining_files` walks `Sys/**` and `rocq_helper_sites`
-- the whole tree, for REG-3's qualifier homes and REG-6's owner.  Each of
-- those reads can only turn a render into a refusal, never change a
-- character of the text, so a warm build does not re-run those rules and
-- the single step that does is `gen_lean_registry.py --check` in
-- `generated-docs` (`lean.yml` runs no such step; its guards run before its
-- build).  That step is therefore load-bearing, and
-- the generator's own test reads the workflow for it.
--
-- Two conditions would falsify the array, and neither is reachable today:
-- a module below `check_lean_spec_parity` or `check_spec_file_map` coming
-- to affect the render rather than a refusal (only `check_lean_pins` can
-- today, through the comment blanking that decides which lines are arms),
-- and a content-identical RENAME of a registry file, which the pins embed
-- as a module path while the array traces bytes -- REG-2 ties the
-- `namespace` line to the path, so a rename that validates changes the
-- bytes too.
--
-- Both roots are leaves today.  A source module under either prefix -- a
-- hand-written `SyscallTable/Extra` beside one of them -- would be claimed
-- by THIS library -- `isBuildableModule` counts a submodule of a root its
-- glob matches, v4.34.0 -- and read from `.lake/generated`, where it is
-- not; that is the 2026-09-16 trap the SysRegistry comment above
-- describes, and `lean_mutate.shadowed_sources` is the check that refuses
-- it.
@[default_target]
lean_lib SysTable where
  srcDir := ".lake/generated"
  roots := #[`LinuxProcessSemantics.LinuxProcessSem.Sys.SyscallTable,
             `LinuxProcessSemantics.LinuxProcessSem.Checks.Cases.SyscallTable]

-- The checked table, its two per-arm alternations and their pins, rendered
-- by `tools/gen_lean_checked.py` from one arm file per checker twin under
-- `Checks/Arms/` (its docstring is the shape and the refusals).  They are
-- build products for the SysTable reason above, one level up: the three
-- hand-written files they replace -- `Checks/Sys/Table.lean`,
-- `Checks/VmMapsDisjoint/Arms.lean` and the alternation half of
-- `Checks/Invariants.lean` -- were edited by every registration, beside the
-- pins in `Checks/Cases/Invariants.lean` and a table literal in
-- `Checks/Cases/Checks/Sys/Mm/Mmap.lean`, so any two open registrations
-- conflicted.  A registration now writes its arm's file and no hub (the
-- replay corpora and the arm's Cases pins are still its own writes).
--
-- The array traces what the text is a function of: the generator and the
-- two tool modules its render reads through (`gen_lean_registry`, whose
-- reader and checks it reuses, and `check_lean_pins`, whose comment
-- blanking decides which lines are declarations), the invariant registry
-- whose list is rendered, the arm files, and the registry files ARM-5 reads.
-- Not traced, as for SysTable: the checker twins ARM-1 asks exist, and the
-- modules `gen_lean_registry` imports for its own rules -- each can only
-- turn a render into a refusal, and `gen_lean_checked.py --check` re-runs
-- every rule in `generated-docs`.
--
-- All four roots are leaves, and no source module sits under any of them:
-- `isBuildableModule` would hand one to this library, as the SysTable
-- comment says, and `lean_mutate.shadowed_sources` refuses it.
@[default_target]
lean_lib CheckedTable where
  srcDir := ".lake/generated"
  roots := #[`LinuxProcessSemantics.LinuxProcessSem.Checks.Sys.Table,
             `LinuxProcessSemantics.LinuxProcessSem.Checks.VmMapsDisjoint.Arms,
             `LinuxProcessSemantics.LinuxProcessSem.Checks.InvariantCoverage,
             `LinuxProcessSemantics.LinuxProcessSem.Checks.Cases.CheckedTable]

def auditWalkModule : Lean.Name := `LinuxProcessSemantics.LinuxProcessSem.Checks.All
def sysTableLib : Lean.Name := `SysTable
def auditModule : Lean.Name := `LinuxProcessSemantics.LinuxProcessSem.Checks.Axioms
def registryModule : Lean.Name := `LinuxProcessSemantics.LinuxProcessSem.Sys.Registry.All
-- The registry files' common prefix: `Sys/Registry/<Mirror>.lean`.
def registryDir : Lean.Name := `LinuxProcessSemantics.LinuxProcessSem.Sys.Registry

-- The modules under `Sys/Registry/`, listed from the library glob, so a
-- registry file is imported by the table the moment it exists; recomputed
-- on every invocation and rewritten only when it changes, as the audit
-- walk is.  Only the glob's own modules qualify: this module itself is not
-- in the glob (it has no source file), and nothing else is named
-- `…Sys.Registry.*`.
-- The one filter both lists below apply, so that the modules the import
-- list names and the files the dependency array traces cannot drift apart:
-- the glob's own modules under the registry prefix, less the generated
-- umbrella itself (which has no source file and is not in the glob anyway).
def registryModules (mod : Module) (who : String) : IO (Array Module) := do
  let some lib := mod.pkg.findLeanLib? `LinuxProcessSemantics
    | throw <| IO.userError s!"{who}: the LinuxProcessSemantics library is missing"
  let walked ← lib.getModuleArray
  return walked.filter fun m => registryDir.isPrefixOf m.name && m.name != registryModule

def registrySource (mod : Module) : IO String := do
  let names := (← registryModules mod "SysRegistry").map (·.name.toString)
  let names := names.qsort (· < ·)
  let note := "/-! Generated by `lean/lakefile.lean` from the modules under `Sys/Registry/`; \
    never edit or commit it. `Sys/SyscallTable.lean` imports it to reach every registry \
    file's arms; `tools/gen_lean_registry.py` writes that table from the same files. -/\n"
  return String.join (names.toList.map fun n => s!"import {n}\n") ++ note

-- The registry files as PATHS, for the table generator's dependency array,
-- from Lake's own module discovery rather than a directory walk: the set is
-- then exactly the modules `Sys.Registry.All` imports, so a fragment added
-- to the tree reaches the import list and the dependency array in the same
-- build, and one removed leaves both.
def registryDeps (mod : Module) : IO (Array FilePath) := do
  let paths := (← registryModules mod "SysTable").map (·.leanFile)
  return paths.qsort fun a b => a.toString < b.toString

-- The arm files' common prefix: `Checks/Arms/<Mirror>.lean`.
def armsDir : Lean.Name := `LinuxProcessSemantics.LinuxProcessSem.Checks.Arms

-- The arm files as PATHS, for the checked-table generator's dependency
-- array, from the library glob as `registryDeps` is, so an arm file added
-- to the tree is traced in the build that first finds it.
def armDeps (mod : Module) : IO (Array FilePath) := do
  let some lib := mod.pkg.findLeanLib? `LinuxProcessSemantics
    | throw <| IO.userError "CheckedTable: the LinuxProcessSemantics library is missing"
  let walked ← lib.getModuleArray
  let paths := (walked.filter fun m => armsDir.isPrefixOf m.name).map (·.leanFile)
  return paths.qsort fun a b => a.toString < b.toString

-- The import list is recomputed from the file system on every invocation;
-- a module appearing or going changes this text, and `writeIfChanged`
-- below says why that alone invalidates `Checks/All` and `Checks/Axioms`.
-- The audit itself is left out because it imports this module.
--
-- The glob walks source files, so the generated modules under
-- `LinuxProcessSem` -- `Sys.Registry.All`, the two rendered by
-- `gen_lean_registry.py` and the four rendered by `gen_lean_checked.py` --
-- are not in this list (the images `RwxImages` and `ExampleImages`
-- render are outside the walk entirely, as the `ChecksAll` comment above
-- says), and they do not need to be: each is already imported by a
-- module that is.  That matters because `tools/check_lean_policy.py` holds
-- the audit to every module under `.lake/generated` as much as every source
-- one, so a generated module no import reaches would fail the policy gate
-- as an unaudited module.  `Sys.Registry.All` arrives through the table,
-- the table through everything that dispatches, and
-- `Checks.Cases.SyscallTable`, which nothing needs, through the umbrella
-- `LinuxProcessSemantics.lean`.  Of the four, `Checks.Sys.Table` arrives
-- through everything that checks, `Checks.InvariantCoverage` through
-- `Checks/Invariants.lean`, `Checks.VmMapsDisjoint.Arms` through
-- `Checks/Cases/Checks/VmMapsDisjoint.lean` alone, and
-- `Checks.Cases.CheckedTable`, which nothing needs, through the umbrella.
-- The two umbrella imports are pinned, with that reason, by
-- tools/test_lean_axioms_glob.py.
def auditWalkSource (mod : Module) : IO String := do
  let some lib := mod.pkg.findLeanLib? `LinuxProcessSemantics
    | throw <| IO.userError "ChecksAll: the LinuxProcessSemantics library is missing"
  let walked ← lib.getModuleArray
  let names := walked.filterMap fun m =>
    if m.name == auditModule then none else some m.name.toString
  let names := names.qsort (· < ·)
  let note := "/-! Generated by `lean/lakefile.lean` from the `LinuxProcessSemantics` \
    library's module glob; never edit or commit it. `Checks/Axioms.lean` imports \
    it so its environment audit walks every module the glob finds. -/\n"
  return String.join (names.toList.map fun n => s!"import {n}\n") ++ note

-- A generated source is rewritten only when its text changes.  Lake
-- v4.34.0 keys a module's rebuild on a hash of its source text (an mtime
-- counts only under `lake build --old`), and an importer's trace carries
-- the traces of what it imports, so a generated module and everything
-- above it rebuild exactly when the module's text changes; rewriting the
-- same text would rebuild nothing either.  The skip is not what keeps the
-- rebuild exact; it keeps an unchanged file unchanged on disk.
def writeIfChanged (path : FilePath) (text : String) : IO Unit := do
  createParentDirs path
  let current ← (do
    if ← path.pathExists then some <$> IO.FS.readFile path
    else pure none : IO (Option String))
  if current != some text then
    IO.FS.writeFile path text

-- The input facet must wait for generation: extraDepTargets alone run after
-- Lake has already tried to read the generated source's import header.
@[«module_facet»]
def generatedInput : ModuleFacetDecl := {
  name := Module.inputFacet
  config := mkFacetJobConfig fun mod => do
    if mod.lib.name == `ChecksAll && mod.name == auditWalkModule then
      writeIfChanged mod.leanFile (← auditWalkSource mod)
    if mod.lib.name == `SysRegistry && mod.name == registryModule then
      writeIfChanged mod.leanFile (← registrySource mod)
    if mod.lib.name == sysTableLib then
      -- One module per invocation: `--module` picks which of the two the
      -- tool writes, because both facet jobs may run at once and a tool
      -- writing both would have them write each other's file.
      let root := mod.pkg.dir / ".."
      let tool := root / "tools/gen_lean_registry.py"
      -- What the array traces is what the SysTable comment above says:
      -- the generator, the Rocq table, the registry files, and the three
      -- tool modules the generator's own rules read through.  Of those
      -- three only `check_lean_pins` can change the rendered text today
      -- (its comment blanking decides which registry lines are arms); the
      -- parity checker and the file map are read for rules that refuse and
      -- are traced because they are readers the render's rules run
      -- through, not docs tools.  The seven other modules the generator
      -- imports -- `specdeps`, `lean_cases_family` and five `lean_port_*`
      -- modules -- are reached only on refusal paths and are not traced.  The cost of
      -- tracing one more path is NOT a rebuild of the model: the product is
      -- rewritten only when its text changes and every module's trace is
      -- on that text, so an over-traced input costs one generator run per
      -- build in which it changed.  What it costs is a build record: every
      -- path traced here is mirrored in
      -- tools/check_lean_port_scope.py's LEAN_BUILD_INPUTS (its test reads
      -- the literals below), and a PR outside the port that touches one
      -- must carry `Lean build: ok at <sha>`.  That is the line the split
      -- is drawn on, and what a warm build then does not re-run -- a
      -- refusal a docs-tool change would newly raise -- is exactly what
      -- `gen_lean_registry.py --check` re-runs in `generated-docs` on
      -- every PR.  The split is not left to a reader:
      -- the generator's own test walks the generator's imports
      -- with `ast` and refuses a new one this array neither names nor
      -- excludes by name.
      let inputs := #[tool, root / "tools/check_lean_pins.py",
        root / "tools/check_lean_spec_parity.py", root / "tools/check_spec_file_map.py",
        root / "theories/LinuxProcessSem/Sys/SyscallTable.v"] ++ (← registryDeps mod)
      let deps ← Job.collectArray <$> inputs.mapM (fun path => inputBinFile path)
      let generated ← buildFileAfterDep mod.leanFile deps (fun _ => do
        createParentDirs mod.leanFile
        proc {cmd := "python3", args := #[tool.toString,
          "--out-dir", mod.lib.srcDir.toString,
          "--module", mod.name.toString, root.toString]} ) (text := true)
      discard <| generated.await
    if mod.lib.name == `CheckedTable then
      -- One module per invocation, as for SysTable; the CheckedTable comment
      -- above says what the array traces and what it leaves to `--check`.
      let root := mod.pkg.dir / ".."
      let tool := root / "tools/gen_lean_checked.py"
      let inputs := #[tool, root / "tools/gen_lean_registry.py",
        root / "tools/check_lean_pins.py",
        mod.pkg.dir / "LinuxProcessSemantics/LinuxProcessSem/Checks/InvariantRegistry.lean"] ++
        (← armDeps mod) ++ (← registryDeps mod)
      let deps ← Job.collectArray <$> inputs.mapM (fun path => inputBinFile path)
      let generated ← buildFileAfterDep mod.leanFile deps (fun _ => do
        createParentDirs mod.leanFile
        proc {cmd := "python3", args := #[tool.toString,
          "--out-dir", mod.lib.srcDir.toString,
          "--module", mod.name.toString, root.toString]} ) (text := true)
      discard <| generated.await
    if mod.lib.name == `RwxImages then
      let root := mod.pkg.dir / ".."
      let imgDir := root / "theories/Examples/rwx_flag_ns"
      -- Re-read the candidate chunk set on every invocation. The generator
      -- rejects any other dependency name, so introducing a new chunk cannot
      -- leave later edits to that chunk outside Lake's dependency trace.
      let entries ← imgDir.readDir
      let chunks := entries.filterMap fun entry =>
        if (entry.fileName.startsWith "SourceMemImage_seg_" ||
            entry.fileName.startsWith "TargetMemImage_seg_") &&
            entry.fileName.endsWith ".hex" then some entry.path else none
      let chunks := chunks.qsort fun a b => a.toString < b.toString
      let inputs := #[root / "tools/gen_lean_image.py", root / "tools/gen_fd_lemmas.py",
        imgDir / "SourceMemImage.v", imgDir / "TargetMemImage.v"] ++ chunks
      let deps ← Job.collectArray <$> inputs.mapM (fun path => inputBinFile path)
      let generated ← buildFileAfterDep mod.leanFile deps (fun _ => do
        createParentDirs mod.leanFile
        proc {cmd := "python3", args := #[(root / "tools/gen_lean_image.py").toString,
          "--example-dir", imgDir.toString,
          "--out-dir", mod.leanFile.parent.get!.toString,
          "--module", mod.name.getString!]} ) (text := true)
      discard <| generated.await
    if mod.lib.name == `ExampleImages then
      let root := mod.pkg.dir / ".."
      let examples := root / "theories/Examples"
      -- `LinuxProcessSemantics.Examples.<example>.<module>`
      let exName := mod.name.getPrefix.getString!
      let exDir := examples / exName
      -- The chunk set is re-read as for RwxImages; the generator also reads
      -- the example's gen-fd-lemmas rule in `dune` for its .text range.
      let entries ← exDir.readDir
      let chunks := entries.filterMap fun entry =>
        if (entry.fileName.startsWith "SourceMemImage_seg_" ||
            entry.fileName.startsWith "TargetMemImage_seg_") &&
            entry.fileName.endsWith ".hex" then some entry.path else none
      let chunks := chunks.qsort fun a b => a.toString < b.toString
      let inputs := #[root / "tools/gen_lean_example_image.py", examples / "dune",
        exDir / "SourceMemImage.v", exDir / "TargetMemImage.v"] ++ chunks
      let deps ← Job.collectArray <$> inputs.mapM (fun path => inputBinFile path)
      let generated ← buildFileAfterDep mod.leanFile deps (fun _ => do
        createParentDirs mod.leanFile
        proc {cmd := "python3", args := #[(root / "tools/gen_lean_example_image.py").toString,
          exName, "--examples-dir", examples.toString,
          "--out-dir", mod.leanFile.parent.get!.toString,
          "--module", mod.name.getString!]} ) (text := true)
      discard <| generated.await
    let source ← Module.inputFacetConfig.run mod
    if mod.name == `LinuxProcessSemantics.LinuxProcessSem.Bridge.Exit then
      -- include_str reads the file during elaboration; put its content hash
      -- in the source trace so a warm build cannot retain an old theorem.
      let contract ← inputBinFile (mod.pkg.dir / "../theories/LinuxProcessSem/Bridge/exit.hex")
      return source.zipWith
        (fun input _ => {input with trace := input.trace.mix contract.getTrace}) contract
    else
      pure source
}

-- The trace runner (ticket H3): test tooling, outside the audited
-- `LinuxProcessSemantics` prefix and never imported by a project module
-- (`tools/check_lean_policy.py` reads its sources for the textual proof
-- policy and refuses the reverse import).  The library carries the
-- runner's modules and its `example` tests; the executable's root imports
-- `Checks.ExecutableSpecs` and nothing under `Examples`, so building it
-- never touches the rwx image roots above.  Both are default targets so an
-- ordinary `lake build` compiles the runner and its tests.
@[default_target]
lean_lib LpsRunner where
  globs := #[.submodules `LpsRunner]

@[default_target]
lean_exe lps_runner where
  root := `LpsRunner.Main
