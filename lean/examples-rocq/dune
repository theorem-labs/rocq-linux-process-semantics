(rocq.theory
 (name LinuxProcessSemantics.Examples)
 (theories Stdlib stdpp ReadFile LinuxProcessSemantics LinuxProcessSemantics.Common))

(subdir rwx_flag_ns
 (rule
  (target rwx_flag_ns_code.v)
  (deps
   %{project_root}/tools/gen_fd_lemmas.py
   (glob_files *MemImage.v)
   (glob_files *MemImage_seg_*.hex)
   (glob_files %{project_root}/theories/Riscv/*.vo))
  ; The source image is a single RWX LOAD segment (see source/rwx.lds), so
  ; its .text cannot be located as the nonzero run — the segment also holds
  ; the ELF headers and the writable data.  The range is passed explicitly
  ; and the source fetch lemmas are stated over fetch_word_wx.
  (action
   (run python3 %{project_root}/tools/gen_fd_lemmas.py rwx_flag_ns
    --source-text 0x10078:0x100e4
    --examples-dir .. --loadpath %{project_root}/theories --out %{target})))
 (rule
  (target Checker.v)
  (deps %{project_root}/tools/gen_checker.py)
  (action
   (run python3 %{project_root}/tools/gen_checker.py rwx_flag_ns --out %{target}))))
