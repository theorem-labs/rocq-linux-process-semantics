; The example proofs, installed by the opam package
; rocq-linux-process-semantics-examples.
(include_subdirs qualified)

; The MemImage files pull in their segment bytes with Rocq's
;   From <dir> Extra Dependency "<...>.hex" as <...>
; `rocq dep` does report those .hex files as dependencies, but only if it can
; find them — and dune copies a source file into the build tree only once
; some rule has asked for it.  Nothing in a rocq.theory asks (there is no
; (extra_files) field), so the dependency scan would run against a build tree
; with no .hex in it, report nothing, and `rocq compile` would then fail to
; find them.
;
; HexDeps.v breaks the cycle: it is a *generated* member of the theory, so
; it must be built before `rocq dep` can run over the theory's sources, and
; building it drags every .hex into the build tree.  Its contents are
; irrelevant — only the dependency edge matters.
(rule
 (target HexDeps.v)
 (deps (glob_files_rec *.hex))
 (action (with-stdout-to HexDeps.v (echo "(* Generated: see the dune file. *)\n"))))

; ---------------------------------------------------------------------------
; Generated members of the theory, two per example.  dune makes them in
; _build; they are not in the repository.  Both generators read only files
; that are in the repository, and both write only VM-checked or type-checked
; content.  Thus a generator bug cannot make a proof pass: it makes the build
; fail.
;
;   <name>/<name>_code.v  fetch/decode lemmas, from the two memory images
;                         (gen-fd-lemmas).  The generator runs `rocq` on
;                         the decoder in Riscv/.  In a full build, the rule
;                         depends on the Riscv/*.vo files of the core theory
;                         and --loadpath points at their build directory.
;                         In a `dune build -p` of the examples package, that
;                         directory is empty and the generator uses the
;                         installed core package.  The dependency is on
;                         theories/Riscv only: Riscv/Decode needs only
;                         Stdlib and stdpp, and a recursive glob over
;                         theories/ would include theories/Examples and
;                         make a cycle.
;
;   <name>/Checker.v      the top-level check (tools/gen_checker.py), a
;                         fixed template with the example name in it.
;
; To add an example, copy the pair of stanzas of an example below and change
; the name.  If you forget, the build fails with "<name>_code.v not found".
; See README.md.

(rocq.theory
 (name LinuxProcessSemantics.Examples)
 (package rocq-linux-process-semantics-examples)
 ; Flocq: the installed LinuxProcessSemantics requires it, and dune does not
 ; know the dependencies of an installed theory.
 (theories Stdlib stdpp ReadFile Flocq LinuxProcessSemantics LinuxProcessSemantics.Common))

(subdir rwx_flag_ns
 (rule
  (target rwx_flag_ns_code.v)
  (deps
   %{project_root}/tools/gen_fd_lemmas.py
   (glob_files *MemImage.v)
   (glob_files *MemImage_seg_*.hex)
   (glob_files %{project_root}/theories/Riscv/*.vo))
  ; The source image is a single RWX LOAD segment (see source/rwx.lds), so
  ; its .text cannot be located as the nonzero run — the segment also holds
  ; the ELF headers and the writable data.  The range is passed explicitly
  ; and the source fetch lemmas are stated over fetch_word_wx.
  (action
   (run python3 %{project_root}/tools/gen_fd_lemmas.py rwx_flag_ns
    --source-text 0x10078:0x100e4
    --examples-dir .. --loadpath %{project_root}/theories --out %{target})))
 (rule
  (target Checker.v)
  (deps %{project_root}/tools/gen_checker.py)
  (action
   (run python3 %{project_root}/tools/gen_checker.py rwx_flag_ns --out %{target}))))

(subdir forkwait
 (rule
  (target forkwait_code.v)
  (deps
   %{project_root}/tools/gen_fd_lemmas.py
   (glob_files *MemImage.v)
   (glob_files *MemImage_seg_*.hex)
   (glob_files %{project_root}/theories/Riscv/*.vo))
  ; forkwait is ONE binary making a halting claim, not an equivalence pair,
  ; so --single, and its image module is named for the example rather than
  ; for a side.  Its .text needs no explicit range: the executable LOAD is
  ; r-x with p_filesz 0x68, which is the 26 instructions and nothing else.
  (action
   (run python3 %{project_root}/tools/gen_fd_lemmas.py forkwait
    --single --source-image ForkwaitMemImage
    --examples-dir .. --loadpath %{project_root}/theories --out %{target}))))
