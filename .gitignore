# dune
_build/
*.install

# Rocq build outputs (from a build outside dune, for example coqc or an editor)
*.vo
*.vok
*.vos
*.glob
*.aux
.*.aux
*.cmi
*.cmo
*.cmx
*.cmxs
*.o
.lia.cache
.nia.cache
.coq-native/
Makefile.coq
Makefile.coq.conf
.Makefile.coq.d
Makefile.rocq
Makefile.rocq.conf
.Makefile.rocq.d

# Example binaries.  Only their snapshots (*MemImage.v and the .hex files)
# are in the repository.
theories/Examples/*/source/program
theories/Examples/*/target/program
theories/Examples/*/target/program.o

# Generated by dune into _build.  An in-source copy makes dune stop with
# "multiple rules generated for ...".
theories/Examples/*/Checker.v
theories/Examples/*/*_code.v

# Python
__pycache__/
*.pyc

# Lean twin build outputs (lean/README.md).  `.lake` holds both the build
# tree and the generated sources the lakefile writes.
lean/.lake/
