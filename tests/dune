; THE NEGATIVES.  Each takes a record, moves one byte of the block the
; kernel wrote, and demands that the model DISAGREE with it, so a block_ok
; that had stopped computing anything would not stay green.  One on the
; shortest record and one on the longest, moving a byte in a different part
; of the block: argc's low byte at the bottom, and a byte of the string area
; near the top.  Each names its admitted neighbour, which is the same record
; with the byte the kernel wrote.
(rule
 (targets StartStateNorandmapsSeed1FixtureMoved.v)
 (deps
  %{project_root}/tools/placement_conformance/start_state_to_rocq.py
  placement/linux-6.18.46-norandmaps-seed1-fixture.log)
 (action
  (run python3 %{project_root}/tools/placement_conformance/start_state_to_rocq.py
   placement/linux-6.18.46-norandmaps-seed1-fixture.log
   --out StartStateNorandmapsSeed1FixtureMoved.v
   --perturb-byte 0 --sibling StartStateNorandmapsSeed1Fixture)))

(rule
 (targets StartStateDefconfigSeed2LongMoved.v)
 (deps
  %{project_root}/tools/placement_conformance/start_state_to_rocq.py
  placement/linux-6.18.46-defconfig-seed2-long.log)
 (action
  (run python3 %{project_root}/tools/placement_conformance/start_state_to_rocq.py
   placement/linux-6.18.46-defconfig-seed2-long.log
   --out StartStateDefconfigSeed2LongMoved.v
   --perturb-byte 7000 --sibling StartStateDefconfigSeed2Long)))

