; Tests that belong to no opam package.  A plain `dune build` runs them.

; Make a 9.4 MiB code segment through elf-snapshot, which splits its bytes
; into two .hex chunks.  Then check, with vm_compute, a read and an
; instruction fetch that span the join of the two chunks.  dune makes the
; files in _build only.
(rule
 (targets
  LargeChunkImage.v
  LargeChunkImage_seg_000_chunk_000.hex
  LargeChunkImage_seg_000_chunk_001.hex)
 (deps
  %{project_root}/tools/elf_snapshot.py
  %{project_root}/tools/gen_fd_lemmas.py
  %{project_root}/tools/test_elf_snapshot.py)
 (action
  (run python3 %{project_root}/tools/test_elf_snapshot.py
   --emit-large-rocq-check LargeChunkImage.v)))

; THE REAL-KERNEL START STATE (OSSV-257 A4, tools/placement_conformance).
; Each rule turns one start-state log of the probe into a Rocq file that
; states the recorded launch as LPS terms and closes three lemmas by
; computation: Run.entry_launch_ok_va of the recorded stack end, stack
; pointer and mmap base; Run.entry_stack_image equal to the bytes the kernel
; wrote, every byte of them; and StackLayout.auxv_entries equal to the
; recorded auxiliary vector.  So each file compiles exactly when LPS's entry
; block is the block that kernel laid.  dune makes the files in _build only;
; the README in tools/placement_conformance says how a log is made.
(rule
 (targets StartStateNorandmapsSeed1Fixture.v)
 (deps
  %{project_root}/tools/placement_conformance/start_state_to_rocq.py
  placement/linux-6.18.46-norandmaps-seed1-fixture.log)
 (action
  (run python3 %{project_root}/tools/placement_conformance/start_state_to_rocq.py
   placement/linux-6.18.46-norandmaps-seed1-fixture.log
   --out StartStateNorandmapsSeed1Fixture.v)))

(rule
 (targets StartStateNorandmapsSeed1Long.v)
 (deps
  %{project_root}/tools/placement_conformance/start_state_to_rocq.py
  placement/linux-6.18.46-norandmaps-seed1-long.log)
 (action
  (run python3 %{project_root}/tools/placement_conformance/start_state_to_rocq.py
   placement/linux-6.18.46-norandmaps-seed1-long.log
   --out StartStateNorandmapsSeed1Long.v)))

